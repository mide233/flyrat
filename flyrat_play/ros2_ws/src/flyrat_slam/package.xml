<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>flyrat_slam</name>
  <version>0.1.0</version>
  <description>Runs headless VINS-Fusion stereo-inertial SLAM on the
    real-vehicle sensor topics forwarded over adb, and publishes odometry, TF,
    path and status for Foxglove and algorithm development.</description>
  <maintainer email="flyrat@example.com">flyrat maintainers</maintainer>
  <license>GPL-3.0-or-later</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>sensor_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>diagnostic_msgs</depend>
  <depend>std_srvs</depend>
  <depend>tf2_ros</depend>
  <depend>message_filters</depend>
  <depend>eigen</depend>
  <depend>libceres-dev</depend>
  <depend>libboost-dev</depend>
  <depend>libopencv-dev</depend>

  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>flyrat_sensors</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
