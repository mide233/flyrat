<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>flyrat_odometry</name>
  <version>0.1.0</version>
  <description>Odometry for the real-vehicle sensor stream. The default
    tio_odometry_node runs the TIO-Former ToF-inertial model through libtorch
    and publishes odometry, path and status topics. The older stereo node is
    kept as a legacy scaffold.</description>
  <maintainer email="flyrat@example.com">flyrat maintainers</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>sensor_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>diagnostic_msgs</depend>
  <depend>std_srvs</depend>
  <depend>tf2_ros</depend>
  <depend>message_filters</depend>
  <depend>flyrat_sensors_interfaces</depend>
  <depend>libopencv-dev</depend>

  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>flyrat_sensors</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
