<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>flyrat_odometry</name>
  <version>0.1.0</version>
  <description>Stereo-inertial odometry for the real-vehicle sensor stream. It
    synchronises stereo images and IMU samples forwarded over adb, runs the
    SchurVINS backend, maintains the body/camera TF tree, and publishes
    odometry, path and status topics.</description>
  <maintainer email="flyrat@example.com">flyrat maintainers</maintainer>
  <!-- The ROS node is MIT; the vendored SchurVINS/SVO frontend is GPL-3.0. -->
  <license>MIT</license>
  <license>GPL-3.0-only</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>sensor_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>diagnostic_msgs</depend>
  <depend>std_srvs</depend>
  <depend>tf2_ros</depend>
  <depend>message_filters</depend>
  <depend>libopencv-dev</depend>

  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>flyrat_sensors</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
