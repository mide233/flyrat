<?xml version="1.0" ?>
<!--
  Betaflight SITL + Gazebo Harmonic world.

  The iris model (model://betaflight_iris, our override of the upstream
  betaloop_iris_with_standoffs that fixes the QUADX rotor order expected by the
  BetaflightPlugin) carries the system plugin, which bridges Gazebo and
  Betaflight SITL over UDP:
    - 9002  SITL -> Gazebo  motor commands
    - 9003  Gazebo -> SITL  simulated IMU / GPS / barometer state

  Physics is stepped at 400 Hz (max_step_size 0.0025 s, real_time_factor 1),
  which keeps the simulated IMU feeding SITL at a rate its estimator expects.

  Resource resolution (models) is provided by the launcher
  (flyrat_play/gazebo/scripts/launch_sim.sh) through
  GZ_SIM_RESOURCE_PATH / SDF_PATH.

  Scenery is built from static primitives only (no external meshes, no extra
  textures) so the world stays self-contained and cheap to simulate:
    - a take-off pad and a raised landing platform,
    - a fly-through gate, two shipping containers and a few poles,
    - six buildings of different heights around the perimeter,
    - six trees and two low barriers.
  The volume within ~3 m of the origin is deliberately kept clear so take-off
  and landing behave the same as in the minimal world.
-->
<sdf version="1.9">
  <world name="betaflight_sitl">

    <spherical_coordinates>
      <surface_model>EARTH_WGS84</surface_model>
      <world_frame_orientation>ENU</world_frame_orientation>
      <latitude_deg>40.46350</latitude_deg>
      <longitude_deg>-79.51825</longitude_deg>
      <elevation>0</elevation>
      <heading_deg>0</heading_deg>
    </spherical_coordinates>

    <!-- Physics: 400 Hz integration, real time -->
    <physics name="sitl" type="ignored">
      <real_time_factor>1</real_time_factor>
      <max_step_size>0.0025</max_step_size>
    </physics>

    <!-- Required system plugins -->
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics">
    </plugin>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands">
    </plugin>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster">
    </plugin>
    <plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu">
    </plugin>

    <!-- Sky and ambient light -->
    <scene>
      <ambient>0.55 0.55 0.55 1</ambient>
      <background>0.72 0.82 0.92 1</background>
      <shadows>true</shadows>
      <grid>false</grid>
    </scene>

    <!-- Lighting -->
    <light name="sun" type="directional">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <attenuation>
        <range>1000</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <!-- Ground plane -->
    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>5000 5000</size>
            </plane>
          </geometry>
          <surface>
            <friction>
              <ode>
                <mu>1</mu>
                <mu2>1</mu2>
              </ode>
            </friction>
          </surface>
        </collision>
        <visual name="grass">
          <pose>0 0 -0.1 0 0 0</pose>
          <cast_shadows>false</cast_shadows>
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>5000 5000</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.3 0.5 0.3 1</ambient>
            <diffuse>0.3 0.5 0.3 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- ==================================================================
         Scenery.  Everything below is static and uses primitive geometry.
         ================================================================== -->

    <!-- Take-off pad: visual only, so the vehicle rests on the ground plane.
         The drone spawns at (0, 0, 0.5), facing +y (yaw = 90 deg). -->
    <model name="takeoff_pad">
      <static>true</static>
      <pose>0 0 0.005 0 0 0</pose>
      <link name="link">
        <visual name="pad">
          <cast_shadows>false</cast_shadows>
          <geometry>
            <cylinder>
              <radius>1.6</radius>
              <length>0.01</length>
            </cylinder>
          </geometry>
          <material>
            <ambient>0.85 0.85 0.85 1</ambient>
            <diffuse>0.9 0.9 0.9 1</diffuse>
          </material>
        </visual>
        <visual name="marker">
          <pose>0 0 0.006 0 0 0</pose>
          <cast_shadows>false</cast_shadows>
          <geometry>
            <cylinder>
              <radius>0.5</radius>
              <length>0.012</length>
            </cylinder>
          </geometry>
          <material>
            <ambient>0.9 0.55 0.1 1</ambient>
            <diffuse>0.95 0.6 0.1 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Raised landing platform: a useful target for precision-landing tests.
         Top surface sits at z = 0.6. -->
    <model name="landing_platform">
      <static>true</static>
      <pose>6 6 0.3 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <box>
              <size>3 3 0.6</size>
            </box>
          </geometry>
          <surface>
            <friction>
              <ode>
                <mu>1</mu>
                <mu2>1</mu2>
              </ode>
            </friction>
          </surface>
        </collision>
        <visual name="body">
          <geometry>
            <box>
              <size>3 3 0.6</size>
            </box>
          </geometry>
          <material>
            <ambient>0.45 0.45 0.5 1</ambient>
            <diffuse>0.5 0.5 0.55 1</diffuse>
          </material>
        </visual>
        <visual name="marking">
          <pose>0 0 0.301 0 0 0</pose>
          <cast_shadows>false</cast_shadows>
          <geometry>
            <box>
              <size>2.2 0.15 0.002</size>
            </box>
          </geometry>
          <material>
            <ambient>0.95 0.75 0.1 1</ambient>
            <diffuse>1 0.8 0.1 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Fly-through gate, 6 m in front of the spawn point (towards +y).
         Clear opening: 3.75 m wide, 3.1 m high. -->
    <model name="gate_left">
      <static>true</static>
      <pose>-2 6 1.6 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <box>
              <size>0.25 0.25 3.2</size>
            </box>
          </geometry>
        </collision>
        <visual name="body">
          <cast_shadows>true</cast_shadows>
          <geometry>
            <box>
              <size>0.25 0.25 3.2</size>
            </box>
          </geometry>
          <material>
            <ambient>0.85 0.35 0.1 1</ambient>
            <diffuse>0.9 0.4 0.1 1</diffuse>
          </material>
        </visual>
      </link>
    </model>
    <model name="gate_right">
      <static>true</static>
      <pose>2 6 1.6 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <box>
              <size>0.25 0.25 3.2</size>
