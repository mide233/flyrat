    <!-- Iris quadcopter with the Betaflight bridge plugin -->
    <include>
      <uri>model://betaflight_iris</uri>
      <name>iris</name>
      <pose>0 0 0.5 0 0 1.5708</pose>
    </include>

    <gui fullscreen="0">
