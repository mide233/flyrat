      <static>true</static>
      <pose>-6 10 0 0 0 0</pose>
      <link name="link">
        <collision name="trunk_collision">
          <pose>0 0 1.2 0 0 0</pose>
          <geometry>
            <cylinder>
              <radius>0.18</radius>
              <length>2.4</length>
