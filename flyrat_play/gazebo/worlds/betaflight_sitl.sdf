          </geometry>
        </collision>
        <visual name="body">
          <cast_shadows>true</cast_shadows>
          <geometry>
            <cylinder>
              <radius>0.12</radius>
              <length>3</length>
            </cylinder>
          </geometry>
          <material>
            <ambient>0.8 0.8 0.8 1</ambient>
            <diffuse>0.85 0.85 0.85 1</diffuse>
          </material>
        </visual>
      </link>
    </model>
    <model name="pole_3">
      <static>true</static>
